# cinterop definition template for the x0x FFI static library.
#
# `shared/build.gradle.kts` reads this file, appends `compilerOpts` with the
# absolute -I path to ffi/x0x-ffi/include, and registers the generated def
# with each iOS target's cinterop. Bindings are generated from the header
# alone; the libx0x_ffi.a archive itself is linked into the final app by
# Xcode (see the iosApp project: "Build x0x FFI" script phase +
# OTHER_LDFLAGS[sdk=…]).
package = x0x.ffi
headers = x0x_ffi.h
headerFilter = x0x_ffi.h
