-- LEGACY (docs/adr/ADR-027-assistants.md): superseded by Assistant.sq. Nothing reads or writes this table
-- any more; migrations/18.sqm copies its rows into Assistant/AssistantGrant. It stays in the schema so the
-- older migrations that create it still line up. Keep in sync with migrations/3.sqm.
CREATE TABLE AgentAccess (
    agentId TEXT NOT NULL PRIMARY KEY,
    status TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);
