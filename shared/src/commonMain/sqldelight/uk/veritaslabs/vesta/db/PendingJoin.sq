-- Invite links this device's user has opened and is waiting on (docs/adr/ADR-018-invite-links.md): the Home and its name, the link's
-- secret and the admin agents to ask (comma-separated), and when the link expires. A Request is resent every sync round
-- until an admin's Invite arrives (the row is then deleted) or a Denied does (`denial` is then its reason, kept so the
-- person can be told). One row per Home.
-- Keep in sync with migrations/12.sqm, which creates this table for databases that predate it.
CREATE TABLE IF NOT EXISTS PendingJoin (
    homeId TEXT NOT NULL PRIMARY KEY,
    homeName TEXT NOT NULL,
    secret TEXT NOT NULL,
    adminAgents TEXT NOT NULL,
    expiresAt INTEGER NOT NULL,
    denial TEXT,
    createdAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM PendingJoin ORDER BY createdAt;

selectById:
SELECT * FROM PendingJoin WHERE homeId = ?;

upsert:
INSERT OR REPLACE INTO PendingJoin(homeId, homeName, secret, adminAgents, expiresAt, denial, createdAt) VALUES (?, ?, ?, ?, ?, NULL, ?);

setDenial:
UPDATE PendingJoin SET denial = ? WHERE homeId = ?;

delete:
DELETE FROM PendingJoin WHERE homeId = ?;

deleteExpiredBefore:
DELETE FROM PendingJoin WHERE expiresAt < ?;
