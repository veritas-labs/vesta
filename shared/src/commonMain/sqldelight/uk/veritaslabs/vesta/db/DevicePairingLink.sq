-- Local-only bookkeeping for a pairing link this device has generated
-- (docs/adr/ADR-003-device-sync.md "Device enrollment"). Deliberately NOT a
-- cr-sqlite CRDT table (docs/adr/ADR-001-sync-boundary-and-entity-ids.md):
-- a pairing link only ever matters to the single device that generated it,
-- before that device has joined any DeviceSync group to replicate to — there
-- is no peer to sync it with yet, and no CRDT table would make sense until
-- one exists.
CREATE TABLE DevicePairingLink (
    id TEXT NOT NULL PRIMARY KEY,
    publicKeyHex TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    expiresAt INTEGER NOT NULL,
    consumed INTEGER NOT NULL DEFAULT 0
);

selectActive:
SELECT * FROM DevicePairingLink WHERE consumed = 0 AND expiresAt > ? ORDER BY createdAt DESC LIMIT 1;

insert:
INSERT OR REPLACE INTO DevicePairingLink(id, publicKeyHex, createdAt, expiresAt, consumed)
VALUES (?, ?, ?, ?, 0);

markConsumed:
UPDATE DevicePairingLink SET consumed = 1 WHERE id = ?;

deleteExpired:
DELETE FROM DevicePairingLink WHERE expiresAt <= ?;

deleteById:
DELETE FROM DevicePairingLink WHERE id = ?;
