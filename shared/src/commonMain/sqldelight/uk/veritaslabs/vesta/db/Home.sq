-- A shared workspace that people (Profiles) join as members (FR-1, FR-2,
-- CORE-EXPERIENCE.md "Creating a Home"). `shape` is one of the fixed Home
-- Shapes (family / flatshare / single_support / other).
CREATE TABLE Home (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    shape TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM Home;

selectById:
SELECT * FROM Home WHERE id = ?;

selectForMember:
SELECT Home.*
FROM Home
INNER JOIN HomeMember ON HomeMember.homeId = Home.id
WHERE HomeMember.memberId = ?;

insert:
INSERT INTO Home(id, name, shape, createdAt)
VALUES (?, ?, ?, ?);

updateHome:
UPDATE Home SET name = ?, shape = ? WHERE id = ?;

deleteById:
DELETE FROM Home WHERE id = ?;
