-- A device-level Profile: "who is using this app right now?" (FR-43..FR-47,
-- CORE-EXPERIENCE.md "Profiles & Shared Devices"). A device hosts many
-- Profiles; a Home's members are the Profiles that joined it (see Home.sq).
-- x0xInstanceName is the named x0x instance (`x0x start --name <name>`) that
-- distinguishes this Profile's identity on the network; "default" until the
-- Profile is given its own instance.
CREATE TABLE Profile (
    id TEXT NOT NULL PRIMARY KEY,
    displayName TEXT NOT NULL,
    avatarResourceId TEXT,
    x0xInstanceName TEXT NOT NULL DEFAULT 'default'
);

selectAll:
SELECT * FROM Profile ORDER BY displayName COLLATE NOCASE;

selectById:
SELECT * FROM Profile WHERE id = ?;

insert:
INSERT INTO Profile(id, displayName, avatarResourceId, x0xInstanceName)
VALUES (?, ?, ?, ?);

updateProfile:
UPDATE Profile SET displayName = ?, avatarResourceId = ?, x0xInstanceName = ? WHERE id = ?;

updateId:
UPDATE Profile SET id = ? WHERE id = ?;

deleteById:
DELETE FROM Profile WHERE id = ?;

countAll:
SELECT COUNT(*) FROM Profile;
