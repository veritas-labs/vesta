-- The Sync activity log (docs/adr/ADR-033): what moved between this device and others, per Home. Local and unsynced.
-- Keep in sync with migrations/19.sqm, which creates this table for databases that predate it.
-- No content columns: never an item name or title, only which module moved, which way, and with whom.

-- Repeats of the same thing in quick succession fold into one row: `at` is the first occurrence, `lastAt` the latest.
CREATE TABLE IF NOT EXISTS SyncEvent (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    homeId TEXT NOT NULL REFERENCES Home(id) ON DELETE CASCADE,
    at INTEGER NOT NULL,
    lastAt INTEGER NOT NULL,
    kind TEXT NOT NULL,
    module TEXT NOT NULL,
    peerAgent TEXT,
    detail TEXT,
    count INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX IF NOT EXISTS SyncEvent_homeId_lastAt ON SyncEvent(homeId, lastAt);

selectPage:
SELECT * FROM SyncEvent WHERE homeId = ? AND lastAt < ? ORDER BY lastAt DESC, id DESC LIMIT ?;

selectPageOfKind:
SELECT * FROM SyncEvent WHERE homeId = ? AND kind = ? AND lastAt < ? ORDER BY lastAt DESC, id DESC LIMIT ?;

findOpen:
SELECT * FROM SyncEvent
WHERE homeId = :homeId AND module = :module AND peerAgent IS :peerAgent AND kind = :kind AND detail IS :detail AND lastAt >= :since
ORDER BY lastAt DESC, id DESC LIMIT 1;

bump:
UPDATE SyncEvent SET lastAt = ?, count = ? WHERE id = ?;

insert:
INSERT INTO SyncEvent(homeId, at, lastAt, kind, module, peerAgent, detail, count) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

pruneOlderThan:
DELETE FROM SyncEvent WHERE lastAt < ?;

deleteForHome:
DELETE FROM SyncEvent WHERE homeId = ?;
