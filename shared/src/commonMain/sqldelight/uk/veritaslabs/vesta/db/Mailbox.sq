-- This device's side of a Home's mailbox (docs/adr/ADR-020-syncing-without-overlapping-online-time.md). Local and unsynced.
-- Keep in sync with migrations/14.sqm, which creates these tables for databases that predate them.

-- What this device has already put in the mailbox: the heads of each document at its last deposit (32-byte hashes laid end to end).
CREATE TABLE IF NOT EXISTS MailboxWrite (
    homeId TEXT NOT NULL,
    documentId TEXT NOT NULL,
    heads BLOB NOT NULL,
    PRIMARY KEY (homeId, documentId)
);

-- The next entry number this device writes in a Home's mailbox. One counter per Home, shared by its documents.
CREATE TABLE IF NOT EXISTS MailboxSequence (
    homeId TEXT NOT NULL PRIMARY KEY,
    nextSequence INTEGER NOT NULL
);

-- The last entry of each other writer this device has dealt with (applied, or found to be none of its business).
CREATE TABLE IF NOT EXISTS MailboxRead (
    homeId TEXT NOT NULL,
    writerAgentId TEXT NOT NULL,
    lastSequence INTEGER NOT NULL,
    PRIMARY KEY (homeId, writerAgentId)
);

selectHeads:
SELECT heads FROM MailboxWrite WHERE homeId = ? AND documentId = ?;

upsertHeads:
INSERT OR REPLACE INTO MailboxWrite(homeId, documentId, heads) VALUES (?, ?, ?);

selectNextSequence:
SELECT nextSequence FROM MailboxSequence WHERE homeId = ?;

upsertNextSequence:
INSERT OR REPLACE INTO MailboxSequence(homeId, nextSequence) VALUES (?, ?);

selectLastRead:
SELECT lastSequence FROM MailboxRead WHERE homeId = ? AND writerAgentId = ?;

upsertLastRead:
INSERT OR REPLACE INTO MailboxRead(homeId, writerAgentId, lastSequence) VALUES (?, ?, ?);

