-- Version 19 -> 20: adds SyncEvent and PeerSync, the Sync activity log and the per-device last-synced times
-- (see uk/veritaslabs/vesta/db/SyncEvent.sq and PeerSync.sq).
CREATE TABLE IF NOT EXISTS SyncEvent (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    homeId TEXT NOT NULL REFERENCES Home(id) ON DELETE CASCADE,
    at INTEGER NOT NULL,
    lastAt INTEGER NOT NULL,
    kind TEXT NOT NULL,
    module TEXT NOT NULL,
    peerAgent TEXT,
    detail TEXT,
    count INTEGER NOT NULL DEFAULT 1
);
CREATE INDEX IF NOT EXISTS SyncEvent_homeId_lastAt ON SyncEvent(homeId, lastAt);
CREATE TABLE IF NOT EXISTS PeerSync (
    agentId TEXT NOT NULL PRIMARY KEY,
    lastSyncedAt INTEGER NOT NULL
);
